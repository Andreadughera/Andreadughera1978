NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://user:password@host:5432/database
DATABASE_SSL=false
POSTGRES_PASSWORD=change-me-long-random-db-password

# Required before exposing the dashboard/API.
DASHBOARD_PASSWORD=change-me-long-random-password
SESSION_SECRET=change-me-long-random-session-secret
CORS_ORIGINS=https://your-dashboard-domain.example
COOKIE_SECURE=false

# Encrypts newly saved CDC API keys in the settings table.
SETTINGS_ENCRYPTION_KEY=change-me-long-random-encryption-key

# Keep false/absent until the deployment, IP whitelist, API permissions, and risk settings are verified.
LIVE_TRADING_ENABLED=false

# High-risk strategy disabled by default; only enable after review.
ENABLE_LISTING_AUTO_TRADE=false

# Never enable in production live trading.
ALLOW_MOCK_MARKET_DATA=false

# Crypto.com Exchange keys may also be supplied via env instead of the settings page.
CDC_API_KEY=
CDC_SECRET_KEY=
